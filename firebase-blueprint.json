{
  "entities": {
    "License": {
      "title": "License",
      "description": "Premium customer license key record",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Unique key matching activeLicenses"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of key creation"
        }
      },
      "required": ["key", "createdAt"]
    },
    "File": {
      "title": "File",
      "description": "Hosted binary files such as CRX or ZIP updates",
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "description": "The name of the file (SyncRate.zip, SyncRate.crx)"
        },
        "base64Data": {
          "type": "string",
          "description": "Base64 encoded binary content"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of modification"
        }
      },
      "required": ["filename", "base64Data", "updatedAt"]
    },
    "Trial": {
      "title": "Trial",
      "description": "Server-side trial activation records keyed by installId",
      "type": "object",
      "properties": {
        "installId": {
          "type": "string",
          "description": "Unique browser installation ID"
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of trial activation"
        }
      },
      "required": ["installId", "activatedAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback submission from the browser extension",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Contact email of the user (optional)"
        },
        "message": {
          "type": "string",
          "description": "Feedback or report message content"
        },
        "version": {
          "type": "string",
          "description": "Extension version"
        },
        "tier": {
          "type": "string",
          "description": "Active license tier"
        },
        "browser": {
          "type": "string",
          "description": "Browser details"
        },
        "installId": {
          "type": "string",
          "description": "Browser installation ID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        }
      },
      "required": ["message", "version", "tier", "browser", "installId", "createdAt"]
    },
    "Install": {
      "title": "Install",
      "description": "Device installation mapping for licensing bounds",
      "type": "object",
      "properties": {
        "licenseKey": {
          "type": "string",
          "description": "Associated license key"
        },
        "installId": {
          "type": "string",
          "description": "Unique browser installation ID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Mapping timestamp"
        }
      },
      "required": ["licenseKey", "installId", "createdAt"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Secure online/simulated checkout transaction state record",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "description": "Cryptographically secure identifier"
        },
        "amount": {
          "type": "number",
          "description": "USD value amount of transaction"
        },
        "isDonation": {
          "type": "boolean",
          "description": "Whether transaction is a donation"
        },
        "tier": {
          "type": "string",
          "description": "Selected product tier (pro, pro_plus)"
        },
        "email": {
          "type": "string",
          "description": "Customer/payer email address"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Selected checkout gateway (global, ru, crypto)"
        },
        "status": {
          "type": "string",
          "description": "Transaction payment status (pending, completed, failed)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction last updated timestamp"
        },
        "stripeSessionId": {
          "type": "string",
          "description": "Optional external Stripe session ID"
        }
      },
      "required": ["transactionId", "amount", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "licenses/{licenseId}": {
      "schema": "License",
      "description": "Collection of activated license keys"
    },
    "files/{fileId}": {
      "schema": "File",
      "description": "Collection of uploaded update files"
    },
    "trials/{installId}": {
      "schema": "Trial",
      "description": "Collection of activated trial installations"
    },
    "feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "Collection of user feedback submissions"
    },
    "installs/{installRecordId}": {
      "schema": "Install",
      "description": "Collection of device bindings and license limits"
    },
    "payment_transactions/{transactionId}": {
      "schema": "PaymentTransaction",
      "description": "Collection of checkout transactions and statuses"
    }
  }
}
