# Environment Variables Example
# Copy this file to .env and fill in the values

# The URL of the application (used for Chrome extension update XML)
APP_URL=https://your-app-url.run.app

# Gemini API Key (if needed for future AI features)
GEMINI_API_KEY=

# Secret token required to safely publish extension ZIP-archive updates
# Set this to a secure random string (ensure they match)
PUBLISH_SECRET=
VITE_PUBLISH_SECRET=

# PayAnyWay integration secret key (merchant signature word)
PAYANYWAY_SECRET_KEY=
PAYANYWAY_MNT_ID=

# Stripe payment gateway keys (for worldwide card checkouts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# JWT secret key for signing user sessions and app tiers
JWT_SECRET=

# Firebase configuration parameters
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=

